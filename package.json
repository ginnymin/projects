{
  "name": "projects",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/favorite-dogs-matcher",
    "apps/multifilterinput",
    "apps/rest-countries-switcher",
    "apps/rock-paper-scissors",
    "apps/smoothie-recipebook",
    "apps/wordle"
  ],
  "scripts": {
    "build:scripts": "tsc --project scripts/tsconfig.scripts.json",
    "generate:app": "yarn build:scripts && node scripts/generate-app/generate.js",
    "generate:component": "yarn build:scripts && node scripts/generate-component/generate.js",
    "build": "yarn workspaces run build",
    "lint": "yarn lint:root && yarn workspaces run lint --diagnostic-level=error",
    "lint:root": "tsc && biome check scripts",
    "test": "yarn workspaces run test --silent",
    "dev:countries": "yarn workspace rest-countries-switcher dev",
    "dev:dogs": "yarn workspace favorite-dogs-matcher dev",
    "dev:multifilterinput": "yarn workspace multifilterinput dev",
    "dev:rock": "yarn workspace rock-paper-scissors dev",
    "dev:smoothies": "yarn workspace smoothie-recipebook dev",
    "dev:wordle": "yarn workspace wordle dev"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sass": "1.102.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "prompts": "2.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
