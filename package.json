{
  "name": "projects",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/favorite-dogs-matcher",
    "apps/multifilterinput",
    "apps/rest-countries-switcher",
    "apps/rock-paper-scissors",
    "apps/smoothie-recipebook"
  ],
  "scripts": {
    "build:scripts": "tsc --project scripts/tsconfig.scripts.json",
    "generate:app": "yarn build:scripts && node scripts/generate-app/generate.js",
    "generate:component": "yarn build:scripts && node scripts/generate-component/generate.js",
    "build": "yarn workspaces run build",
    "lint": "yarn lint:root && yarn workspaces run lint --quiet",
    "lint:root": "tsc && eslint './*.{js,mjs,ts}'",
    "test": "yarn workspaces run test --silent",
    "dev:countries": "yarn workspace rest-countries-switcher dev",
    "dev:dogs": "yarn workspace favorite-dogs-matcher dev",
    "dev:rock": "yarn workspace rock-paper-scissors dev",
    "dev:smoothies": "yarn workspace smoothie-recipebook dev"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "clsx": "2.1.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.7.0",
    "sass": "1.101.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/eslint-config-prettier": "6.11.3",
    "@types/eslint__eslintrc": "3.3.0",
    "@types/eslint__js": "9.14.0",
    "@types/node": "26.1.0",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/eslint-plugin": "1.6.20",
    "eslint": "10.6.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.16",
    "prompts": "2.4.2",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
